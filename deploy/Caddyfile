# Production Caddyfile.
#
# Serves trinket on every domain listed below. Routes everything to the trinket
# app EXCEPT the Socket.IO paths for the server-side language sandboxes, which
# go to the sandbox container directly.
#
# Primary domain comes from {$DOMAIN} (freetrinket.io). Additional domains are
# listed explicitly in their own site blocks so each gets its own Let's Encrypt
# cert. Add more by copying the `import trinket_site` block.

{
    email {$ACME_EMAIL}
}

# Shared routing for every trinket domain.
(trinket_site) {
    encode zstd gzip

    # Server-side language sandboxes (Socket.IO over WebSocket / long-poll).
    @sandbox path /python3/socket.io* /java/socket.io* /r/socket.io*
    reverse_proxy @sandbox sandbox:8080

    # Everything else: the trinket Hapi app.
    reverse_proxy app:3000
}

# Redirect www -> apex (only works if you've pointed a www record at this
# droplet; harmless to leave in otherwise).
www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

# Primary domain.
{$DOMAIN} {
    import trinket_site
}

# Additional domain: trinket.strivemath.org.
trinket.strivemath.org {
    import trinket_site
}
